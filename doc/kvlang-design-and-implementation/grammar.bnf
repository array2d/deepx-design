# kvlang 语法 (BNF)

> 锚定于 kvlang-deep-dive（根设计文档）——每次 deep-dive 更新后需验证本文与实现一致。
> 验证：`python3 tutorial/test.py && python3 tutorial/error_test.py`
> 更新于 2026-07-30：scope 帧重设计（todo-036），print/println Go 风格（print 无空格无换行，println 有空格有换行）。

## 词法

```
digit   = "0" … "9"
letter  = "a" … "z" | "A" … "Z" | "_"
ident   = letter { letter | digit }
integer = digit { digit }
float   = integer [ "." integer ] [ ("e" | "E") [ "+" | "-" ] integer ]
path    = "/" { ident | integer | "[" integer "," integer "]" } [ "." ident ]

              (* 成员访问：[] 数组下标，. dict 成员 / lib 函数 *)
member_access = expr "[" index "]"                     (* 同构 XValue 数组下标，ElemSize>0 *)
              | expr "." ident                         (* dict/little 成员 or lib 函数限定名 *)
              | expr "." "*" ident                     (* dict 动态成员，key 取值而非字面量 *)

index          = expr                                  (* 整数类型 or 返回整数的表达式 *)
string  = '"' { char } '"' | "'" { char } "'" | "`" { char } "`"
comment = "#" { char } newline
```

## 程序结构

```
              (* 无 import 关键字——lib 树即全局命名空间，跨 lib 调用走全路径 /lib/{lib}.{func}() *)

init_block  = "init" "{" { statement } "}"

              (* 声明签名，无体，解释器直执行 *)

top_level_stmt = instruction | function_call
               (* 顶层无嵌套控制流; if/while/for 必须在 函数内 *)

function    = "rwfunc" ident "(" [ param_list ] ")" [ "->" "(" [ param_list ] ")" ]
              "{" { statement } "}"

rwir_decl   = "rwir" ident "(" [ param_list ] ")" [ "->" "(" [ param_list ] ")" ]
              (* 声明签名，无体，解释器直执行 *)

              (* 声明签名，无体，解释器直执行 *)

param_list  = param { "," param }
param       = ident [ ":" type_expr [ "..." ] ]  (* type 可选；末参可带 "..." 变参，见「类型表达式」节 *)

statement   = instruction | if_stmt | while_stmt | for_stmt | block_stmt
```

## 类型表达式（签名参数/返回值类型，多态 + 高维数组）

> 完整语义见 [[runtime篇-07-签名类型表达式]]。铁律：无家族简写（`int`/`uint`/`float`/`num`/`char`）——位宽是开放集合（int4/fp8/fp16…），编码须写明确（`char/utf8`、`char/utf32`）；多态靠显式 `|` 枚举；kind 只接受精确 kind 串，无 `charbyte`。

```
type_expr   = atom { "|" atom }                  (* 并集：A|B 表 A 或 B *)
atom        = [ dims ] ( any | kind )
dims        = "[]"                               (* 1 维、长度任意，等价 [?] *)
            | "[" dim { "," dim } "]"            (* 逗号分割的维；rank = 项数 *)
dim         = integer | "?"                      (* 精确大小 或 动态维 *)
any         = "any"                              (* 通配，匹配任意 kind *)
kind        = 精确 kind 串                        (* bool、int8..uint64、float32/64、char·、dict、index、extindex、rwir、rwfunc、scope、time、duration *)
variadic    = type_expr "..."                    (* 仅末参：0..N 个同型实参，每个按 type_expr 匹配 *)
```

## 指令

```
instruction = [ writes "=" ] expr
            | [ writes "<-" ] expr
            | expr [ "->" writes ]
            | expr                     (* 纯副作用调用 *)

writes      = write_slot { "," write_slot }
write_slot  = ident                    (* 裸名：帧内变量 *)
            | path                     (* 绝对路径 / 成员：/a/b  /a.b *)
            | ident "." ident          (* 成员写：base.field *)
            | ident "." "*" ident      (* 动态键写：base.*key, fix-015 *)
            | ident "[" expr "]"       (* 下标写：arr[idx] *)
```

## 表达式

```
expr        = primary { infix_primary }
            | prefix_unary primary

primary     = literal | ident | path | ident "." ident | ident "." "*" ident
            | ident "[" expr "]"       (* 下标读 *)
            | "(" expr ")"             (* 分组 *)
            | ident "(" [ arg_list ] ")"  (* 函数调用 *)
            | dict_literal
            | array_literal

prefix_unary = "-" | "!"

infix_primary = binary_op expr

binary_op  = "+" | "-" | "*" | "/" | "%" | "==" | "!=" | "<" | ">" | "<=" | ">="
           | "&&" | "||" | "&" | "|" | "^" | "<<" | ">>"

arg_list    = expr { "," expr }

literal     = integer | float | string | "null" | "true" | "false"

array_literal = "[" [ expr { "," expr } ] "]"         (* [1,2,3] → array(1,2,3) *)

dict_literal = "{" [ dict_entry { (";" | newline) dict_entry } ] "}"
dict_entry   = ident "=" expr                          (* { k=v; k2=v2 } *)
```

## 控制流（仅限 def 体内）

```
if_stmt     = "if" "(" expr ")" "{" { statement } "}"

              (* 声明签名，无体，解释器直执行 *)
              [ "else" "{" { statement } "}" ]

              (* 声明签名，无体，解释器直执行 *)

while_stmt  = "while" "(" expr ")" "{" { statement } "}"

              (* 声明签名，无体，解释器直执行 *)

for_stmt    = "for" "(" ident "in" ident ")" "{" { statement } "}"

              (* 声明签名，无体，解释器直执行 *)
              (* for (x in arr) — arr 为键族/数组 *)

block_stmt  = ident ":" "{" { statement } "}"         (* label: { ... } *)

              (* 声明签名，无体，解释器直执行 *)
```

## 内建函数（部分）

```
builtin_call = ("print" | "println" | "cerr" | "input"
              | "abs" | "neg" | "sign" | "pow" | "sqrt" | "exp" | "log"
              | "min" | "max"
              | "int8" | "int16" | "int32" | "int64"
              | "uint8" | "uint16" | "uint32" | "uint64"
              | "float32" | "float64"
              | "char" | "ord" | "strlen" | "strcmp" | "strstr"
              | "slice" | "concat"
              | "array" | "len" | "at" | "set" | "has" | "sort"
              | "dict" | "kvat" | "kvhas"
              | "debugger") "(" [ arg_list ] ")"

(* min/max 支持变参: min(a,b,c,...), fix-026 *)
(* print  : Go 风格——无空格拼接，不追加换行 *)
(* println: Go 风格——空格分隔，追加换行 *)
(* debugger(): 内联暂停, 非调试模式 no-op, fix-031 *)
(* / : 两侧 int → 整除(C 风格); 任一侧 float → 浮除, fix-020 *)
(* s[i] 读返单字符字符串, 越界返 ""; s[i]="X" 单字符替换写回新串, fix-025 *)
(* + 作用在 string∧string → 拼接, fix-025 *)
```
